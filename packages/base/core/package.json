    "test:package": "publint"
  },
  "devDependencies": {
    "@cyco130/eslint-config": "^6.2.1",
    "eslint": "^10.0.2",
    "publint": "^0.3.18",
    "tsdown": "0.21.2",
    "typescript": "^5.9.3"
  }
