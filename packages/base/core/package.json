{
  "name": "@hattip/core",
  "version": "0.1.0",
  "description": "hattip",
  "keywords": [
    "nextjs",
    "react",
    "ssr",
    "vite"
  ],
  "license": "MIT",
  "repository": "github:cyco130/hattip",
  "files": [
